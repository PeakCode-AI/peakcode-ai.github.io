---
import { dlIcon } from '../utils/icons';

const GITHUB_OWNER = 'PeakCode-AI';
const GITHUB_REPO = 'PeakCode';
const GITHUB_RELEASES = `https://github.com/${GITHUB_OWNER}/${GITHUB_REPO}/releases`;

let releaseTag = 'v0.0.1';
let releaseUrl = `${GITHUB_RELEASES}/tag/v0.0.1`;
const assetUrlMap: Record<string, string> = {};

try {
  const res = await fetch(`https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/releases/latest`);
  if (res.ok) {
    const data = await res.json();
    releaseTag = data.tag_name;
    releaseUrl = data.html_url;
    for (const asset of data.assets) {
      const name = asset.name;
      if (!name.includes('.blockmap') && !name.endsWith('.yml')) {
        assetUrlMap[name] = asset.browser_download_url;
      }
    }
  }
} catch (_) {}

const ver = releaseTag.replace(/^v/, '');

function assetUrl(archExt: string): string | undefined {
  return assetUrlMap[`Peak-Code-${ver}-${archExt}`];
}

const macIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47c-1.34.03-1.77-.79-3.29-.79c-1.53 0-2 .77-3.27.82c-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51c1.28-.02 2.5.87 3.29.87c.78 0 2.26-1.07 3.8-.91c.65.03 2.47.26 3.64 1.98c-.09.06-2.17 1.28-2.15 3.81c.03 3.02 2.65 4.03 2.68 4.04c-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5c.13 1.17-.34 2.35-1.04 3.19c-.69.85-1.83 1.51-2.95 1.42c-.15-1.15.41-2.35 1.05-3.11z"/></svg>`;
const winIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>`;
const linuxIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8s8 3.59 8 8s-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>`;

const platforms = [
  {
    name: "macOS",
    icon: macIcon,
    versions: [
      { label: "Apple Silicon (M1/M2/M3/M4)", id: "download.macos.v1", arch: "arm64.dmg" },
      { label: "Intel Chip", id: "download.macos.v2", arch: "x64.dmg" },
    ],
    badge: "Recommended",
  },
  {
    name: "Windows",
    icon: winIcon,
    versions: [
      { label: "Installer (.exe)", id: "download.windows.v1", arch: "x64.exe" },
      { label: "Portable (.zip)", id: "download.windows.v2", arch: "x64.zip" },
    ],
    badge: null,
  },
  {
    name: "Linux",
    icon: linuxIcon,
    versions: [
      { label: "AppImage (Universal)", id: "download.linux.v1", arch: "x86_64.AppImage" },
    ],
    badge: null,
  },
];
---

<section class="download" id="download">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title" data-i18n="download.title">Download PeakCode</h2>
      <p class="section-desc" data-i18n="download.desc">Available for macOS, Windows, and Linux. Free and open source.</p>
    </div>

    <div class="platforms">
      {platforms.map((p, i) => (
        <div class="platform reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="platform-header">
            <div class="platform-icon"><span set:html={p.icon} /></div>
            <div>
              <div class="platform-name">{p.name}</div>
              {p.badge && <span class="platform-badge" data-i18n="download.badge">{p.badge}</span>}
            </div>
          </div>
          <div class="versions">
            {p.versions.map(v => {
              const url = assetUrl(v.arch);
              return (
                <a href={url || '#'} class={`version-link${url ? '' : ' disabled'}`} target={url ? '_blank' : ''} rel={url ? 'noopener noreferrer' : ''}>
                  <span set:html={dlIcon} />
                  <span data-i18n={v.id}>{v.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <div class="download-footer reveal">
      <p data-i18n="download.footer" data-i18n-html>Prefer the command line? <code>brew install peakcode</code> or <code>winget install PeakCode</code></p>
      <p class="sub">Latest release: <strong>{releaseTag}</strong> · <a href={releaseUrl} target="_blank" rel="noopener noreferrer">View changelog</a> · <a href={GITHUB_RELEASES} target="_blank" rel="noopener noreferrer">All releases</a></p>
    </div>
  </div>
</section>

<style>
  .download { padding: 100px 0; background: var(--bg-subtle); }
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 64px; }
  .section-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px; color: var(--fg); }
  .section-desc { font-size: 1.05rem; color: var(--fg-muted); line-height: 1.7; }
  .platforms { display: grid; gap: 24px; max-width: 960px; margin: 0 auto; }
  @media (min-width: 768px) { .platforms { grid-template-columns: repeat(3, 1fr); } }
  .platform { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; transition: box-shadow 0.3s, border-color 0.3s; }
  .platform:hover { box-shadow: var(--shadow); border-color: #dbeafe; }
  .platform-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
  .platform-icon { width: 44px; height: 44px; border-radius: var(--radius); background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; }
  .platform-icon span { display: flex; }
  .platform-name { font-size: 1.1rem; font-weight: 700; color: var(--fg); }
  .platform-badge { display: inline-block; font-size: 0.7rem; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 8px; border-radius: 100px; margin-top: 4px; }
  .versions { display: flex; flex-direction: column; gap: 10px; }
  .version-link { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 500; color: var(--fg-muted); border: 1px solid var(--border); transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .version-link:hover { border-color: var(--accent); background: var(--accent-light); color: var(--accent); }
  .version-link :global(span:first-child) { display: flex; flex-shrink: 0; }
  .version-link.disabled { opacity: 0.4; cursor: not-allowed; }
  .version-link.disabled:hover { border-color: var(--border); background: transparent; color: var(--fg-muted); }
  .download-footer { text-align: center; margin-top: 48px; }
  .download-footer p { font-size: 0.9rem; color: var(--fg-muted); }
  .download-footer code { background: var(--bg-subtle); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem; color: var(--fg); border: 1px solid var(--border); }
  .download-footer .sub { margin-top: 8px; font-size: 0.8rem; color: var(--fg-subtle); }
  .download-footer a { color: var(--accent); font-weight: 500; }
  .download-footer a:hover { text-decoration: underline; }
</style>
