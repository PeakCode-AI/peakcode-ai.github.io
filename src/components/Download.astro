    versions: [
      { label: "Installer (.exe)", id: "download.windows.v1", file: "PeakCode-win32-x64.exe" },
      { label: "Portable (.zip)", id: "download.windows.v2", file: "PeakCode-win32-x64.zip" },
    ],
    badge: null,
  },
  {
    name: "Linux",
