---
const testimonials = [
  {
    id: "testimonials.t1",
    quote: "PeakCode completely changed how I write code. The multi-model support means I can use Claude for reasoning tasks and GPT for quick completions. And it's open source.",
    name: "Sarah Chen",
    role: "Staff Engineer at Vercel",
  },
  {
    id: "testimonials.t2",
    quote: "We switched our entire team to PeakCode. The local model support is a game-changer for privacy-sensitive projects. Zero regrets.",
    name: "Marcus Johnson",
    role: "CTO at FintechFlow",
  },
  {
    id: "testimonials.t3",
    quote: "I was paying $20/month for Cursor. PeakCode gives me the same experience for free, and I can self-host it. The community is incredible too.",
    name: "Yuki Tanaka",
    role: "Indie Developer",
  },
  {
    id: "testimonials.t4",
    quote: "The refactoring tool is scary good. I described a complex migration in plain English and it handled 90% of the work. Reviewed and shipped the same day.",
    name: "David Okonkwo",
    role: "Senior Dev at Stripe",
  },
  {
    id: "testimonials.t5",
    quote: "Finally an AI editor that doesn't feel like a black box. Being able to see exactly what model is running and where my data goes — that's priceless.",
    name: "Elena Rossi",
    role: "Security Engineer",
  },
  {
    id: "testimonials.t6",
    quote: "Built a custom plugin for our internal tools in an afternoon. The extension API is clean, well-documented, and actually fun to use.",
    name: "James Park",
    role: "Platform Engineer at Linear",
  },
];
---

<section class="testimonials">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title" data-i18n="testimonials.title">Loved by developers</h2>
      <p class="section-desc" data-i18n="testimonials.desc">Join thousands of developers who've made PeakCode their daily driver.</p>
    </div>

    <div class="grid">
      {testimonials.map((t, i) => (
        <div class="card reveal" style={`transition-delay: ${i * 60}ms`}>
          <div class="stars">★★★★★</div>
          <p class="quote" data-i18n={t.id}>{t.quote}</p>
          <div class="author">
            <div class="avatar">{t.name.charAt(0)}</div>
            <div class="info">
              <div class="name" data-i18n={`${t.id}.name`}>{t.name}</div>
              <div class="role" data-i18n={`${t.id}.role`}>{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials { padding: 100px 0; background: var(--bg-subtle); }
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 64px; }
  .section-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px; color: var(--fg); }
  .section-desc { font-size: 1.05rem; color: var(--fg-muted); line-height: 1.7; }
  .grid { display: grid; gap: 24px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; transition: box-shadow 0.3s, border-color 0.3s; }
  .card:hover { box-shadow: var(--shadow); border-color: #dbeafe; }
  .stars { color: #f59e0b; font-size: 0.9rem; letter-spacing: 2px; margin-bottom: 16px; }
  .quote { font-size: 0.95rem; color: var(--fg-muted); line-height: 1.7; flex: 1; margin-bottom: 24px; }
  .author { display: flex; align-items: center; gap: 12px; }
  .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; }
  .name { font-size: 0.9rem; font-weight: 600; color: var(--fg); }
  .role { font-size: 0.8rem; color: var(--fg-subtle); }
</style>
