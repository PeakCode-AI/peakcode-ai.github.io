---
import { layersIcon, monitorIcon, gitBranchIcon, refreshIcon, terminalIcon, globeIcon } from '../utils/icons';

const features = [
  { id: "features.f1", icon: layersIcon, title: "Multi-Agent, One Interface", desc: "Seamlessly switch between Claude Code, Codex, Gemini, Kilo Code, OpenCode, and more — all from a single unified window." },
  { id: "features.f2", icon: monitorIcon, title: "Real-Time Streaming", desc: "Watch AI agents work in real-time. See code being written, tools being invoked, and results appearing instantly. No polling, no refreshing." },
  { id: "features.f3", icon: gitBranchIcon, title: "Git Integration", desc: "Built-in version control with branch management, staging, committing, and pushing — all from the same interface where you interact with AI." },
  { id: "features.f4", icon: refreshIcon, title: "Session Persistence", desc: "Sessions survive restarts. Smart checkpointing captures conversation state so you can pick up exactly where you left off." },
  { id: "features.f5", icon: terminalIcon, title: "Integrated Terminal & Editor", desc: "Embedded terminal for command execution and a full code editor with syntax highlighting — everything you need without leaving the window." },
  { id: "features.f6", icon: globeIcon, title: "Cross-Platform", desc: "Available as a native desktop app (macOS, Windows, Linux) and a web application you can self-host. Your code stays local, always." },
];
---

<section class="features">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title" data-i18n="features.title">Everything you need to ship faster</h2>
      <p class="section-desc" data-i18n="features.desc">Peak Code combines multiple AI coding agents into one polished, local-first experience. No more juggling terminals.</p>
    </div>

    <div class="grid">
      {features.map((f, i) => (
        <div class="card reveal" style={`transition-delay: ${i * 60}ms`}>
          <div class="card-icon"><span set:html={f.icon} /></div>
          <h3 class="card-title" data-i18n={`${f.id}.title`}>{f.title}</h3>
          <p class="card-desc" data-i18n={`${f.id}.desc`}>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { padding: 100px 0; background: var(--bg); }
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 64px; }
  .section-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px; color: var(--fg); }
  .section-desc { font-size: 1.05rem; color: var(--fg-muted); line-height: 1.7; }
  .grid { display: grid; gap: 24px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .card { padding: 32px; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); transition: box-shadow 0.3s, border-color 0.3s, transform 0.3s; }
  .card:hover { box-shadow: var(--shadow); border-color: #dbeafe; transform: translateY(-2px); }
  .card-icon { width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  .card-icon span { display: flex; }
  .card-title { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: var(--fg); }
  .card-desc { font-size: 0.9rem; color: var(--fg-muted); line-height: 1.7; }
</style>
