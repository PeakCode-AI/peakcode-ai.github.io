---
export interface Props {
  title?: string;
}
const { title = "Peak Code — The open-source GUI for AI coding agents" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Peak Code is the open-source GUI for AI coding agents. One beautiful interface for Claude Code, Codex, Gemini, Kilo Code, OpenCode, and more." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <slot />

  <script>
    import { translations, type Lang } from '../i18n/translations';

    function updateLang(lang: Lang) {
      localStorage.setItem('peakcode-lang', lang);
      document.documentElement.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n')!;
        const text = translations[lang][key as keyof typeof translations.en];
        if (text !== undefined) {
          if (el.hasAttribute('data-i18n-html')) {
            el.innerHTML = text.replace(/\\n/g, '<br>');
          } else {
            el.textContent = text;
          }
        }
      });

      // Update lang buttons
      document.querySelectorAll('.lang-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });
    }

    const saved = (localStorage.getItem('peakcode-lang') as Lang) || 'en';
    updateLang(saved);

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.lang-btn');
      if (btn) {
        const lang = btn.getAttribute('data-lang') as Lang;
        if (lang) updateLang(lang);
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const saved = (localStorage.getItem('peakcode-lang') as Lang) || 'en';
      updateLang(saved);
    });
  </script>

  <style is:global>
    :root {
      --bg: #ffffff;
      --bg-subtle: #f6f8fc;
      --fg: #0b1221;
      --fg-muted: #475569;
      --fg-subtle: #94a3b8;
      --accent: #3b82f6;
      --accent-hover: #2563eb;
      --accent-light: #eef2ff;
      --accent-subtle: rgba(59,130,246,0.08);
      --border: #e2e8f0;
      --border-light: #f1f5f9;
      --card-bg: #ffffff;
      --glow: rgba(59,130,246,0.15);
      --radius: 12px;
      --radius-lg: 16px;
      --radius-sm: 8px;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
      --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 4px 12px rgba(0,0,0,0.04);
      --shadow-lg: 0 8px 24px rgba(0,0,0,0.06), 0 2px 6px rgba(0,0,0,0.03);
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0b1120;
        --bg-subtle: #0f1629;
        --fg: #f1f5f9;
        --fg-muted: #94a3b8;
        --fg-subtle: #64748b;
        --accent: #60a5fa;
        --accent-hover: #3b82f6;
        --accent-light: #1e293b;
        --accent-subtle: rgba(96,165,250,0.08);
        --border: #1e293b;
        --border-light: #1a1f35;
        --card-bg: #0f1729;
        --glow: rgba(96,165,250,0.12);
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.2);
        --shadow: 0 1px 3px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.15);
        --shadow-lg: 0 8px 24px rgba(0,0,0,0.4), 0 2px 6px rgba(0,0,0,0.2);
      }
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--fg);
      line-height: 1.6;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      background-image:
        radial-gradient(circle at 25% 0%, var(--glow) 0%, transparent 50%),
        radial-gradient(circle at 75% 100%, var(--glow) 0%, transparent 50%);
    }

    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }
    img { max-width: 100%; display: block; }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    @media (min-width: 768px) {
      .container { padding: 0 32px; }
    }

    @media (min-width: 1024px) {
      .container { padding: 0 48px; }
    }

    /* Scroll reveal */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</body>
</html>
